{
  "cSpell.language": "en,pt-BR",
  "cSpell.enabled": true,
  "cSpell.allowCompoundWords": true,
  "cSpell.ignorePaths": [
    "docs/**"
  ],
  "cSpell.words": [
    "Axios",
    "FakeStoreAPI",
    "Pinia",
    "PrimeVue",
    "primevue",
    "primeuix",
    "TypeScript",
    "Vue",
    "Vite",
    "Tailwind",
    "tailwindcss",
    "Yup",
    "vee-validate",
    "localStorage",
    "debounce"
  ],
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "editor.formatOnSave": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "vue"
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "css.lint.unknownAtRules": "ignore"
}